# .env.example - 이 파일을 복사해서 .env로 만들고 값을 채우세요
# cp .env.example .env

# OpenSQL-PG local DB (docker-compose 기본값)
DB_HOST=localhost
DB_PORT=55432
DB_NAME=app
DB_USER=app
DB_PASSWORD=local_password
DB_SCHEMA=public
SPRING_PROFILES_ACTIVE=local

# MinIO (docker-compose 기본값)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin1234
MINIO_BUCKET=docgrid
