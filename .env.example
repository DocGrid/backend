# .env.example — 이 파일을 복사해서 .env로 만들고 값을 채우세요
# cp .env.example .env

# PostgreSQL (docker-compose 기본값)
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/docgrid
LOCAL_DB_USERNAME=docgrid
LOCAL_DB_PASSWORD=docgrid1234

# MinIO (docker-compose 기본값)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin1234
MINIO_BUCKET=docgrid
